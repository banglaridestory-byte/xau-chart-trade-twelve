PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=your_primary_twelvedata_api_key_here
TWELVE_DATA_API_KEY_2=your_secondary_twelvedata_api_key_here
# Optional: comma-separated alternative to the numbered variables above
TWELVE_DATA_API_KEYS=
AUTH_USERNAME=your_admin_username
AUTH_PASSWORD=your_login_password
AUTH_SECRET=your_long_random_signing_secret

# Telegram alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# How often to check the price when the live stream is unavailable (ms)
ALERT_POLL_INTERVAL_MS=30000
# How often to retry a failed Telegram send (ms)
ALERT_RETRY_INTERVAL_MS=60000
# Optional: where alert state is stored (defaults to .cache/alerts.json)
ALERT_STORE_FILE=
